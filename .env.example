# Ebbinghaus Anywhere 环境变量模板
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略,切勿提交到仓库。

# Django SECRET_KEY(必须)
# 生成方式(无需安装任何依赖): python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your_django_secret_key

# 百度翻译 API(可选,不配置则禁用在线释义功能)
# 参考: https://cloud.baidu.com/doc/MT/s/nkqrzmbpc
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# DeepSeek API(可选,仅 scripts/ 下的一次性数据整理脚本使用)
DEEPSEEK_API_KEY=

# 实例角色(NAS 副本专用;主库请勿设置,否则会尝试加载仅副本所需的组件)
# EAW_ROLE=replica
