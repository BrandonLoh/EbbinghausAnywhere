<view class="page">

  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-title">你好，{{displayName || '…'}} 👋</view>
    <view class="hero-sub">已坚持 {{stats.days_since_first_item}} 天 · 共 {{stats.total_items}} 个条目</view>
  </view>

  <!-- 今日待复习 -->
  <view class="card due-card" bindtap="goToday" hover-class="is-pressed">
    <view class="due-label">今日待复习</view>
    <view class="due-num">{{stats.today_due}}</view>
    <view class="btn btn-lg btn-primary btn-block">开始复习</view>
  </view>

  <!-- 选择其它日期 -->
  <picker mode="date" value="{{today}}" bindchange="onPickDate">
    <view class="list">
      <view class="list-item" hover-class="is-pressed">
        <view class="row-main">
          <view class="row-title">选择其它日期复习</view>
          <view class="row-sub">{{today}}</view>
        </view>
        <view class="chevron">›</view>
      </view>
    </view>
  </picker>

  <!-- 退出登录 -->
  <view class="list logout-list">
    <view class="list-item logout-item" bindtap="onLogout" hover-class="is-pressed">
      <view class="logout-text">退出登录</view>
    </view>
  </view>

</view>
