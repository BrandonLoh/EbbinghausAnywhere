<view class="page" wx:if="{{item}}">

  <!-- 标题区 -->
  <view class="detail-head">
    <view class="detail-title">{{item.item || '(空条目)'}}</view>
    <view class="detail-chips">
      <text class="chip chip-muted" wx:if="{{item.category_name}}">{{item.category_name}}</text>
      <text class="chip {{item.proficiency === 1 ? 'chip-success' : 'chip-warning'}}">{{item.proficiency_label}}</text>
    </view>

    <view class="phonetic" wx:if="{{item.uk_phonetic}}">英 /{{item.uk_phonetic}}/</view>
    <view class="phonetic" wx:if="{{item.us_phonetic}}">美 /{{item.us_phonetic}}/</view>

    <view class="tts-btn" wx:if="{{item.src_tts}}" bindtap="playTts" hover-class="tts-btn-active">🔊 播放发音</view>

    <view class="detail-dates">
      <text>录入 {{item.inputDate}}</text>
      <text>起算 {{item.initDate}}</text>
    </view>
  </view>

  <!-- 内容(大字号,适合手机阅读) -->
  <view class="content-card">
    <view class="content" user-select="{{true}}">{{item.content || '（暂无内容）'}}</view>
  </view>

  <!-- 反馈(底部固定) -->
  <view class="feedback-bar">
    <button class="btn fb-btn btn-success" data-action="yes" bindtap="onFeedback" disabled="{{feedbacking}}">YES</button>
    <button class="btn fb-btn btn-danger" data-action="no" bindtap="onFeedback" disabled="{{feedbacking}}">NO</button>
    <button class="btn fb-btn btn-warning" data-action="reset" bindtap="onFeedback" disabled="{{feedbacking}}">RESET</button>
  </view>

</view>

<view class="empty" wx:if="{{!loading && !item}}">条目不存在或已删除</view>
