.detail-head {
  padding: 40rpx 40rpx 8rpx;
}

.detail-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.detail-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.phonetic {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #495057;
}

/* 发音:浅底 pill 按钮 */
.tts-btn {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  background: #d2e6ec;
  border-radius: 999rpx;
  color: #17667f;
  font-size: 30rpx;
  font-weight: 600;
}

.tts-btn-active {
  background: #c3dde6;
}

.detail-dates {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #adb5bd;
}

/* 内容卡片:正文用 36rpx / 1.9 行高,手机上更好读 */
.content-card {
  margin: 24rpx;
  padding: 36rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.content {
  font-size: 36rpx;
  line-height: 1.9;
  white-space: pre-line;
  word-break: break-all;
}

/* 底部反馈栏 */
.feedback-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #f1f3f5;
}

.fb-btn {
  flex: 1;
  height: 96rpx;
  margin: 0 8rpx;
}

.page {
  padding-bottom: 200rpx;   /* 给底部固定栏留空间 */
}
