.item-title {
  font-size: 44rpx;
  font-weight: 600;
  word-break: break-all;
}

.meta-row {
  margin-top: 20rpx;
}

.meta-row.dates {
  display: flex;
  justify-content: space-between;
  color: #adb5bd;
  font-size: 24rpx;
  margin-top: 28rpx;
}

.phonetics {
  margin-top: 20rpx;
}

.phonetic {
  display: block;
  color: #6c757d;
  font-size: 28rpx;
  margin-top: 6rpx;
}

.tts-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  background: #e7f1ff;
  color: #007bff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* 内容:保留换行,长词折行 */
.content {
  white-space: pre-line;
  word-break: break-all;
  font-size: 30rpx;
  line-height: 1.8;
}

/* 底部反馈栏 */
.feedback-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.fb-btn {
  flex: 1;
  margin: 0 10rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 32rpx;
}

.fb-btn::after {
  border: none;
}

.fb-btn[disabled] {
  opacity: 0.6;
}

.fb-yes {
  background: #28a745;
}

.fb-no {
  background: #dc3545;
}

.fb-reset {
  background: #ffc107;
  color: #212529;
}

.page {
  padding-bottom: 180rpx; /* 给底部固定栏留空间 */
}
