<view class="page login-page">

  <view class="login-brand">
    <view class="login-logo">📚</view>
    <view class="login-title">万物皆可艾宾浩斯</view>
    <view class="login-sub">首次使用请用主站账号绑定，之后自动登录</view>
  </view>

  <view class="login-form">
    <input
      class="input-lg"
      placeholder="主站用户名"
      value="{{username}}"
      bindinput="onUsername"
      confirm-type="next"
    />

    <input
      class="input-lg input-gap"
      password
      placeholder="主站密码"
      value="{{password}}"
      bindinput="onPassword"
      confirm-type="done"
      bindconfirm="onBind"
    />

    <button class="btn btn-lg btn-primary btn-block login-btn" bindtap="onBind" disabled="{{submitting}}" loading="{{submitting}}">
      绑定微信并登录
    </button>

    <view class="hint" bindtap="onDirectLogin">
      仅登录（暂不绑定微信，调试用）
    </view>
  </view>

  <view class="footnote">绑定后，主站和本小程序共用同一套数据</view>
</view>
