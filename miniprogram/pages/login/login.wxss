.login-page {
  padding-bottom: 64rpx;
}

.login-brand {
  padding: 96rpx 64rpx 56rpx;
  text-align: center;
}

.login-logo {
  font-size: 96rpx;
  line-height: 1;
}

.login-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1d809f;
}

.login-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6c757d;
}

.login-form {
  margin: 0 40rpx;
}

.input-gap {
  margin-top: 24rpx;
}

.login-btn {
  margin-top: 40rpx;
}

.hint {
  margin-top: 32rpx;
  text-align: center;
  color: #6c757d;
  font-size: 26rpx;
  text-decoration: underline;
}

.footnote {
  margin-top: 48rpx;
  text-align: center;
  color: #adb5bd;
  font-size: 24rpx;
}
