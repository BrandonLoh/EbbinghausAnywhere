/* 顶部日期条(吸顶) */
.review-top {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 16rpx;
  background: rgba(248, 249, 250, 0.96);
}

/* 日期 pill:点按弹日期选择 */
.date-pill {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.date-pill-active {
  background: #f1f3f5;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d809f;
}

.date-caret {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #adb5bd;
}

.review-count {
  font-size: 26rpx;
  color: #6c757d;
}
