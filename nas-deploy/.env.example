# Ebbinghaus Anywhere —— NAS 副本配置(复制为 .env 后填写)
#
# 生成 SECRET_KEY(与 PA 的可以不同, 各实例独立;无需安装依赖):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=

# 主库快照端点(固定)
EAW_SYNC_URL=https://ebbinghaus.pythonanywhere.com/api/v1/backup/snapshot/

# 主库 syncbot 账号的 API token(在 PA 上用 drf_create_token 生成, 见部署文档)
EAW_SYNC_TOKEN=

# 下列变量已在 docker-compose.yml 中固定, 此处仅作说明, 无需设置:
#   EAW_ROLE=replica
#   DATABASE_URL=sqlite:////data/db.sqlite3
#   EAW_SNAPSHOT_DIR=/data/snapshots
#
# 百度翻译/微信小程序等配置副本不需要: 副本不提供录入与小程序服务。
